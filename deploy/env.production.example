# Colewan Drive — production environment for the VPS.
#
# Copy to /var/www/colewan-drive/.env and fill in the two generated secrets.
# provision.sh does both for you; this file is the reference for what it wrote
# and why.

APP_NAME="Colewan Drive"
APP_ENV=production
# php artisan key:generate writes this. Losing it makes every encrypted session
# and every password-reset token unreadable.
APP_KEY=
APP_DEBUG=false
APP_URL=https://colewan-drive.salidumay.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily rather than single: the stock `single` channel grows one laravel.log
# forever, which on a box with no log rotation for it is a slow disk leak.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB, not SQLite. php8.3 on this server has no sqlite3 extension, so the
# development default cannot boot here at all — and pointing sessions, cache,
# queue and app data at one SQLite file is where "database is locked" comes
# from once uploads and page loads overlap.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=colewan_drive
DB_USERNAME=colewan_drive
DB_PASSWORD=

# Redis is already running on this box and is nearly empty. Keeping sessions
# and cache out of MySQL means a long upload transaction never blocks a page
# load.
#
# REDIS_DB / REDIS_CACHE_DB are set away from the defaults on purpose: another
# app on this server already occupies db1, which is Laravel's stock cache
# database. Sharing it would have `cache:clear` wipe that app's keys.
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=5
REDIS_CACHE_DB=6
REDIS_PREFIX=colewan-drive:

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is HTTPS-only behind certbot, so the cookie should never be allowed
# onto a plaintext request.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Hand file transfers to nginx instead of streaming them through a PHP worker.
# Requires the `location ^~ /internal-downloads/` block in the vhost; the two
# values must agree. Leave DOWNLOAD_DELIVERY unset (or "php") anywhere there is
# no nginx in front, such as local development.
DOWNLOAD_DELIVERY=xaccel
DOWNLOAD_XACCEL_PREFIX=/internal-downloads/

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@salidumay.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
